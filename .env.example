# Copy to .env and fill in. Never commit .env or real credentials.

# --- Required -----------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
# Long random secret used to hash SSN last-four digits, e.g. the output of:
#   python -c "import secrets; print(secrets.token_hex(32))"
HASH_PEPPER=

# --- Models (LiveKit Inference for the LLM, Deepgram for speech) ---------------------
LLM_MODEL=openai/gpt-5.4-mini
# Tried in order if the primary model fails.
LLM_FALLBACK_MODELS=google/gemma-4-31b-it
# Reasoning effort for OpenAI models; low keeps the time to the first word short.
LLM_REASONING_EFFORT=low
PROVIDER_TIMEOUT_SECONDS=10
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# --- Optional Langfuse tracing ------------------------------------------------------
# Leave the keys empty to disable. Conversation content is stripped before export.
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
# (LANGFUSE_BASE_URL is accepted as an alternative name for LANGFUSE_HOST.)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Clinic time (development only) -------------------------------------------------
# false: the real current time in America/New_York decides open/closed (default).
# true:  DEMO_NOW below is used instead. Restart the worker after changing these.
ALLOW_TIME_SIMULATION=false
# Uncomment exactly one while simulation is on (a timezone offset is required).
# Tuesday 10:00 AM Eastern, clinic open:
# DEMO_NOW=2026-11-24T10:00:00-05:00
# Tuesday 7:00 PM Eastern, clinic closed:
# DEMO_NOW=2026-11-24T19:00:00-05:00

# --- Logging ------------------------------------------------------------------------
LOG_LEVEL=INFO
